{
  "builds": [
    {
      "src": "src/backend/server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/backend/server.py"
    },
    {
      "src": "/connect",
      "dest": "/src/agent.py"
    },
    {
      "src": "/run",
      "dest": "/src/agent.py"
    },
    {
      "src": "/",
      "dest": "/src/views/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/src/$1"
    }
  ]
}