% Minimal LuaLaTeX prototype for extracting element metadata\
\
\\documentclass\{article\}\
\\usepackage\{luacode\}\
\\usepackage\{tikz\}\
\\usepackage\{lipsum\}\
\
\\begin\{luacode*\}\
local outname = tex.jobname .. ".elements.json"\
local elements = \{\}\
\
function add_element(name, page, x, y, w, h)\
    elements[name] = \{ page = page, x = x, y = y, width = w, height = h \}\
end\
\
luatexbase.add_to_callback("finish_pdf_file", function()\
    local f = io.open(outname, "w")\
    if not f then return end\
    f:write("\{\\n")\
    local first = true\
    for k, v in pairs(elements) do\
        if not first then f:write(",\\n") end\
        first = false\
        f:write(string.format('  "%s": \{ "page": %d, "x": %d, "y": %d, "width": %d, "height": %d \}',\
            k, v.page, v.x, v.y, v.width, v.height))\
    end\
    f:write("\\n\}\\n")\
    f:close()\
    return true\
end, "write_elements")\
\\end\{luacode*\}\
\
\\makeatletter\
\\newcommand\{\\elementbox\}[2]\{%\
\\begingroup\
  \\setbox0=\\vbox\{#2\}%\
  \\pdfsavepos\\relax\
  \\leavevmode\
  \\box0\
  \\directlua\{\
    local name = [[#1]]\
    local x = tex.pdfposx or 0\
    local y = tex.pdfposy or 0\
    local page = tex.count[0]\
    add_element(name, page, x, y, tex.box[0].width or 0, tex.box[0].height or 0)\
  \}%\
\\endgroup\
\}\
\\makeatother\
\
\\begin\{document\}\
\
\\section*\{Projectile Motion\}\
\
\\begin\{equation\}\
\\elementbox\{range_equation\}\{%\
  $R = \\frac\{u^2 \\sin(2\\theta)\}\{g\}$%\
\}\
\\end\{equation\}\
\
\\begin\{figure\}[h]\
\\centering\
\\begin\{tikzpicture\}[scale=0.6]\
  \\elementbox\{velocity_vector\}\{%\
    \\node[draw] at (0,0) (v) \{\}; \\draw[-stealth, thick] (0,0) -- (3,2);%\
  \}\
  \\elementbox\{trajectory\}\{%\
    \\draw (0,0) parabola (6,0);%\
  \}\
\\end\{tikzpicture\}\
\\caption\{Launch\}\
\\end\{figure\}\
\
\\lipsum[3]\
\
\\end\{document\}\
