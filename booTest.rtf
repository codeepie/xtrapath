// Viewer Logic & Explanation Mode Engine\
// Content is defined as an ordered "script". Each step renders a readable block\
// and speaks its narration; the focused block is spotlighted while others dim.\
\
const book = document.getElementById('book');\
const playBtn = document.getElementById('play');\
const restartBtn = document.getElementById('restart');\
const downloadBtn = document.getElementById('download');\
const barFill = document.querySelector('#bar > div');\
\
// Content Script\
// type: 'heading' | 'text' | 'equation' | 'figure'\
// say: what the narrator reads aloud for this block\
const SCRIPT = [\
  \{\
    type: 'heading',\
    html: 'Projectile Motion',\
    say: 'Projectile motion. Let us explore how objects move through the air.'\
  \},\
  \{\
    type: 'text',\
    html: 'Acceleration is the rate of change of velocity. Near the Earth\'92s surface it points downward.',\
    say: 'Acceleration is the rate of change of velocity. Near the Earth\'92s surface, it points downward.'\
  \},\
  \{\
    type: 'equation',\
    html: 'R = \\\\frac\{u^2 \\\\sin(2\\\\theta)\}\{g\}',\
    say: 'The range equation. R equals u squared times the sine of two theta, divided by g.'\
  \},\
  \{\
    type: 'figure',\
    svg: `<svg viewBox="0 0 340 240" width="340" height="240" xmlns="http://www.w3.org/2000/svg">\
      <defs>\
        <marker id="a" markerWidth="10" markerHeight="10" refX="6" refY="5" orient="auto">\
          <path d="M0,0 L10,5 L0,10 z" fill="#464feb"/>\
        </marker>\
      </defs>\
      <line x1="10" y1="200" x2="330" y2="200" stroke="#bbb" stroke-width="1"/>\
      <path id="p_traj" class="part" d="M10,200 Q160,-30 310,200" stroke="#333" fill="none" stroke-width="2"/>\
      <path id="p_theta" class="part" d="M45,200 A35,35 0 0 0 34,168" stroke="#e67e22" fill="none" stroke-width="3"/>\
      <text id="lbl_theta" class="partlabel" x="52" y="185">\uc0\u952 </text>\
      <line id="p_vel" class="part" x1="10" y1="200" x2="90" y2="120" stroke="#464feb" stroke-width="3" marker-end="url(#a)"/>\
      <text id="lbl_vel" class="partlabel" x="92" y="112">u</text>\
      <circle id="p_dot" class="part" cx="10" cy="200" r="6" fill="#e74c3c"/>\
      <text id="lbl_dot" class="partlabel" x="14" y="224">launch</text>\
    </svg>`,\
    caption: 'Launch point, initial velocity u, angle \uc0\u952 , and the parabolic path.',\
    say: 'Here is the trajectory. Let us look at each part one at a time.',\
    parts: [\
      \{\
        target: 'p_dot',\
        label: 'lbl_dot',\
        say: 'This red dot is the launch point, where the motion begins.'\
      \},\
      \{\
        target: 'p_vel',\
        label: 'lbl_vel',\
        say: 'This blue arrow is the initial velocity u, the speed and direction at launch.'\
      \},\
      \{\
        target: 'p_theta',\
        label: 'lbl_theta',\
        say: 'This orange arc is the launch angle theta, measured from the ground.'\
      \},\
      \{\
        target: 'p_traj',\
        label: null,\
        say: 'This curved line is the parabolic path the object follows.'\
      \}\
    ]\
  \},\
  \{\
    type: 'text',\
    html: 'The horizontal range depends on the launch speed u, the launch angle \uc0\u952 , and gravity g.',\
    say: 'The horizontal range depends on the launch speed, the launch angle, and gravity.'\
  \}\
];\
\
// Build the DOM\
const blocks = SCRIPT.map((item, i) => \{\
  const el = document.createElement('section');\
  el.className = 'block';\
  el.dataset.index = i;\
\
  if (item.type === 'heading') \{\
    el.innerHTML = `<h2>$\{item.html\}</h2>`;\
  \} else if (item.type === 'equation') \{\
    el.innerHTML = `<p class="equation">$\{item.html\}</p>`;\
  \} else if (item.type === 'figure') \{\
    el.innerHTML = `<div class="figure">$\{item.svg\}<div class="caption">$\{item.caption\}</div></div>`;\
  \} else \{\
    el.innerHTML = `<p>$\{item.html\}</p>`;\
  \}\
\
  book.appendChild(el);\
  return el;\
\});\
\
let playing = false;\
let current = -1;\
\
function setFocus(index) \{\
  blocks.forEach((b, i) => \{\
    b.classList.toggle('focus', i === index);\
    b.classList.toggle('done', i < index);\
  \});\
\
  if (index >= 0 && index < blocks.length) \{\
    blocks[index].scrollIntoView(\{ behavior: 'smooth', block: 'center' \});\
    barFill.style.width = ((index + 1) / blocks.length * 100) + '%';\
  \} else if (index < 0) \{\
    barFill.style.width = '0%';\
  \}\
\}\
\
function speak(text) \{\
  return new Promise((resolve) => \{\
    if (!('speechSynthesis' in window)) \{\
      // Fallback if SpeechSynthesis is not supported\
      const ms = Math.max(1500, (text.split(' ').length / 3) * 1000);\
      setTimeout(resolve, ms);\
      return;\
    \}\
\
    speechSynthesis.cancel(); // Clear queued speech\
    const u = new SpeechSynthesisUtterance(text);\
    u.rate = 1;\
    u.pitch = 1;\
\
    let resolved = false;\
    const done = () => \{\
      if (!resolved) \{\
        resolved = true;\
        resolve();\
      \}\
    \};\
\
    u.onend = done;\
    u.onerror = done;\
\
    speechSynthesis.speak(u);\
\
    // Safety fallback timeout\
    const guard = Math.max(4000, (text.split(' ').length / 2) * 1000);\
    setTimeout(() => \{\
      if (playing) done();\
    \}, guard);\
  \});\
\}\
\
// Spotlight one SVG part inside a figure block: dim siblings, glow target, show label\
function spotlightPart(blockEl, targetId, labelId) \{\
  const parts = blockEl.querySelectorAll('.part');\
  parts.forEach(p => \{\
    const isTarget = p.id === targetId;\
    p.classList.toggle('part-glow', isTarget);\
    p.classList.toggle('part-dim', !isTarget);\
  \});\
\
  blockEl.querySelectorAll('.partlabel').forEach(l => \{\
    l.classList.toggle('show', l.id === labelId);\
  \});\
\}\
\
function clearParts(blockEl) \{\
  blockEl.querySelectorAll('.part').forEach(p => p.classList.remove('part-glow', 'part-dim'));\
  blockEl.querySelectorAll('.partlabel').forEach(l => l.classList.remove('show'));\
\}\
\
async function run(from = 0) \{\
  playing = true;\
  playBtn.textContent = 'Pause';\
\
  for (let i = from; i < blocks.length; i++) \{\
    if (!playing) return;\
    current = i;\
    setFocus(i);\
\
    await speak(SCRIPT[i].say);\
    if (!playing) return;\
\
    // Spotlight sub-parts if present\
    const parts = SCRIPT[i].parts;\
    if (parts && parts.length) \{\
      for (const part of parts) \{\
        if (!playing) \{\
          clearParts(blocks[i]);\
          return;\
        \}\
        spotlightPart(blocks[i], part.target, part.label);\
        await speak(part.say);\
      \}\
      clearParts(blocks[i]);\
    \}\
\
    if (!playing) return;\
    await new Promise(r => setTimeout(r, 350)); // Delay between blocks\
  \}\
\
  // Finished playback\
  playing = false;\
  current = -1;\
  playBtn.textContent = 'Play';\
  blocks.forEach(b => b.classList.add('done'));\
\}\
\
function pause() \{\
  playing = false;\
  playBtn.textContent = 'Play';\
  if ('speechSynthesis' in window) speechSynthesis.cancel();\
\}\
\
playBtn.addEventListener('click', () => \{\
  if (playing) \{\
    pause();\
  \} else \{\
    run(current >= 0 ? current : 0);\
  \}\
\});\
\
restartBtn.addEventListener('click', () => \{\
  current = -1;\
  pause();\
  setFocus(-1);\
  blocks.forEach(b => b.classList.remove('done'));\
\});\
\
// Download PDF matching web layout via DOM snapshot\
async function downloadPDF() \{\
  if (!window.html2canvas) \{\
    alert('PDF libraries not loaded yet. Please retry in a moment.');\
    return;\
  \}\
\
  const \{ jsPDF \} = window.jspdf || \{\};\
  if (!jsPDF) \{\
    alert('jsPDF library missing.');\
    return;\
  \}\
\
  pause();\
  downloadBtn.disabled = true;\
  const oldLabel = downloadBtn.textContent;\
  downloadBtn.textContent = 'Generating...';\
\
  // Temporarily force full opacity on all blocks for clean capture\
  book.querySelectorAll('.block').forEach(b => \{\
    b.dataset._op = b.style.opacity;\
    b.style.opacity = '1';\
  \});\
  clearParts(book);\
\
  try \{\
    const canvas = await html2canvas(book, \{ scale: 2, backgroundColor: '#ffffff', useCORS: true \});\
    const doc = new jsPDF(\{ unit: 'pt', format: 'a4' \});\
    \
    const pageW = doc.internal.pageSize.getWidth();\
    const pageH = doc.internal.pageSize.getHeight();\
    const imgW = pageW;\
    const imgH = (canvas.height * imgW) / canvas.width;\
\
    let heightLeft = imgH;\
    let position = 0;\
    const imgData = canvas.toDataURL('image/png');\
\
    doc.addImage(imgData, 'PNG', 0, position, imgW, imgH);\
    heightLeft -= pageH;\
\
    while (heightLeft > 0) \{\
      position = heightLeft - imgH;\
      doc.addPage();\
      doc.addImage(imgData, 'PNG', 0, position, imgW, imgH);\
      heightLeft -= pageH;\
    \}\
\
    doc.save('explanation-mode.pdf');\
  \} catch (e) \{\
    console.error(e);\
    alert('Could not generate PDF: ' + e.message);\
  \} finally \{\
    // Restore styling\
    book.querySelectorAll('.block').forEach(b => \{\
      b.style.opacity = b.dataset._op || '';\
      delete b.dataset._op;\
    \});\
\
    setFocus(current);\
    downloadBtn.disabled = false;\
    downloadBtn.textContent = oldLabel;\
  \}\
\}\
\
downloadBtn.addEventListener('click', downloadPDF);\
\
// Initial state: nothing focused\
setFocus(-1);}